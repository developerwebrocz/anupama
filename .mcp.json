{
  "mcpServers": {
    "novamira-anupamahospitals": {
      "command": "npx",
      "args": ["-y", "@automattic/mcp-wordpress-remote@latest"],
      "env": {
        "WP_API_URL": "https://www.anupamahospitals.com/wp-json/mcp/novamira",
        "WP_API_USERNAME": "webrocz",
        "WP_API_PASSWORD": "${WP_API_PASSWORD}"
      }
    },
    "elevenlabs-chey": {
      "command": "uvx",
      "args": ["elevenlabs-mcp"],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}",
        "ELEVENLABS_VOICE_NAME": "Chey"
      }
    }
  }
}
